# Copy to backend/.env. Paths default to backend/data regardless of the working directory.
# Optional absolute path override, e.g. DATA_DIR=D:/feynman-data
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional environment model. Set key, URL and model or configure them in the workbench.
EMBEDDING_PROVIDER=local_lite
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Optional override; otherwise a persistent local signing key is generated.
JWT_SECRET=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","http://localhost:4173","http://127.0.0.1:4173"]
SEED_DEMO=true


# Read timeout for configured model profiles, in seconds.
MODEL_TIMEOUT_SECONDS=180
