# Copy to backend/.env. Paths default to backend/data regardless of the working directory.
# Optional absolute path override, e.g. DATA_DIR=D:/feynman-data
MOCK_LLM=true
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set MOCK_LLM=false and provide the key, URL and model for your provider.
EMBEDDING_PROVIDER=local_lite
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Optional override; otherwise a persistent local signing key is generated.
JWT_SECRET=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SEED_DEMO=true

